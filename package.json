{
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm --filter trellis-ivy-core build && pnpm --filter trellis-ivy build",
    "build:core": "pnpm --filter trellis-ivy-core build",
    "build:cli": "pnpm --filter trellis-ivy build",
    "test": "pnpm --filter trellis-ivy-core test && pnpm --filter trellis-ivy test",
    "test:core": "pnpm --filter trellis-ivy-core test",
    "test:cli": "pnpm --filter trellis-ivy test",
    "lint": "pnpm --filter trellis-ivy-core lint && pnpm --filter trellis-ivy lint",
    "typecheck": "pnpm --filter trellis-ivy-core build && pnpm --filter trellis-ivy typecheck",
    "release": "pnpm --filter trellis-ivy release",
    "release:minor": "pnpm --filter trellis-ivy release:minor",
    "release:major": "pnpm --filter trellis-ivy release:major",
    "release:beta": "pnpm --filter trellis-ivy release:beta",
    "release:rc": "pnpm --filter trellis-ivy release:rc",
    "release:promote": "pnpm --filter trellis-ivy release:promote",
    "release:check": "node packages/cli/scripts/release-preflight.js check-versions",
    "release:plan": "node packages/cli/scripts/release-preflight.js publish-plan"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
